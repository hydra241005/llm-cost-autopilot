# LLM Cost Autopilot — environment template.
# Copy to .env and fill in only what you need. Nothing here is required:
# with no credentials at all the stack still runs against local Ollama.
#
# .env is git-ignored. Never commit real keys.

# --- Provider credentials -----------------------------------------------------
# Placeholders only. Replace with real values or leave unset to disable
# the provider — unconfigured providers are skipped, not fatal.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides for proxies or compatible gateways.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# Local model server. The free Tier 1 floor; needs no key.
OLLAMA_BASE_URL=http://localhost:11434

# Download missing local models at startup. Off by default: a pull is several
# gigabytes. Run `uv run python scripts/doctor.py` to see what is missing.
OLLAMA_AUTO_PULL=false

# --- Application --------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- Persistence --------------------------------------------------------------
# SQLite by default. Swap in postgresql+asyncpg://user:pass@host:5432/autopilot
# to switch dialects; the migrations are compatible with both.
DATABASE_URL=sqlite+aiosqlite:///./data/autopilot.db

# Optional. When unset, in-process cache, queue, and rate-limit adapters are used.
# REDIS_URL=redis://localhost:6379/0

# --- Routing ------------------------------------------------------------------
ROUTING_CONFIDENCE_THRESHOLD=0.6
ROUTING_BASELINE_MODEL_ID=openai:gpt-4o
ROUTING_MAX_RETRIES=2
ROUTING_TIMEOUT_TIER1_S=10.0
ROUTING_TIMEOUT_TIER2_S=20.0
ROUTING_TIMEOUT_TIER3_S=45.0
ROUTING_BREAKER_FAILURE_THRESHOLD=5
ROUTING_BREAKER_FAILURE_RATE=0.5
ROUTING_BREAKER_WINDOW_S=30.0
ROUTING_BREAKER_COOLDOWN_S=20.0
ROUTING_METRICS_WINDOW_S=300.0

# --- Verification -------------------------------------------------------------
VERIFY_ENABLED=true
VERIFY_BASE_SAMPLE_RATE=0.10
VERIFY_DAILY_BUDGET_USD=5.00

# --- Cache --------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_S=3600

# --- API ----------------------------------------------------------------------
API_AUTH_ENABLED=false
DEFAULT_RATE_LIMIT_RPM=60
MAX_REQUEST_BYTES=256000
